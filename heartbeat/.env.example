# Toolstem mainnet heartbeat — environment variables (PLACEHOLDERS ONLY).
# Copy to `.env` and fill with real values OUTSIDE of version control, or wire
# these as secrets in your scheduler (GitHub Actions secret, cron host env, etc).
# NEVER commit a filled-in copy. NEVER paste a real key into the repo.

# ---- REQUIRED ----

# Private key of a funded Base MAINNET wallet that will sign the USDC payments.
# 0x-prefixed hex. This wallet needs a small USDC balance (a few cents per run)
# plus a little ETH on Base for L2 gas. The heartbeat reads this by name only.
HEARTBEAT_WALLET_PRIVATE_KEY=0xYOUR_FUNDED_BASE_MAINNET_WALLET_PRIVATE_KEY

# ---- OPTIONAL ----

# Hard per-call safety cap in USD. Any quoted payment requirement above this is
# filtered out and the call aborts rather than paying. Defaults to 0.02 if unset
# — enough for the two intended tiers ($0.01 + $0.005) with margin, but below any
# standard ($0.05) or premium ($0.50) tool so a mis-quote can never overpay.
HEARTBEAT_MAX_PAYMENT_USD=0.02

# ---- NOT USED BY THIS SCRIPT (documented for the operator) ----
#
# The heartbeat does NOT call the CDP facilitator directly — the toolstem-proxy
# Cloudflare Worker does, using ITS OWN Worker secrets. These are listed here
# only so the operator knows what to verify/keep current; the heartbeat itself
# never reads them:
#
#   CDP_API_KEY_ID      — Coinbase CDP API key id used by the deployed Worker
#   CDP_API_KEY_SECRET  — Coinbase CDP API key secret used by the deployed Worker
#
# Use these same CDP creds (by name) if you want to run the discovery GET that
# verifies re-listing — see README "Verifying re-listing".
